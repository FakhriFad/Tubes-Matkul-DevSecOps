# ============================================================
# Copy this file to .env and fill in all values.
# Never commit .env to version control.
# ============================================================

# PostgreSQL
POSTGRES_DB=ecommerce
POSTGRES_USER=ecom_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# JWT  (generate with: openssl rand -hex 64)
JWT_SECRET=CHANGE_ME_JWT_SECRET_MINIMUM_64_CHARACTERS_LONG

# Frontend API URL (as seen from the browser)
NEXT_PUBLIC_API_URL=https://localhost/api

# CORS origin for the backend
CORS_ORIGIN=https://localhost

# Logging (error | warn | info | http | debug)
LOG_LEVEL=info

# Default admin account (created automatically on first startup)
ADMIN_EMAIL=admin@shop.local
ADMIN_PASSWORD=Admin@12345

# Grafana dashboard password (monitoring stack)
GRAFANA_PASSWORD=admin

# Brute-force protection (login lockout)
BRUTE_MAX_ATTEMPTS=5
BRUTE_WINDOW_SECS=900
BRUTE_LOCKOUT_SECS=900
