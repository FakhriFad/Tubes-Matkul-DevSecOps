{
  "title": "EcomShop — Application Dashboard",
  "uid": "ecomshop-main",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Request Rate (req/s)",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "sum(rate(ecomshop_http_requests_total[1m]))", "legendFormat": "req/s" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" },
        "thresholds": { "steps": [{"color":"green","value":0},{"color":"yellow","value":50},{"color":"red","value":100}] } } }
    },
    {
      "id": 2, "type": "stat", "title": "Error Rate (%)",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "100 * sum(rate(ecomshop_http_requests_total{status_code=~'5..'}[1m])) / sum(rate(ecomshop_http_requests_total[1m]))", "legendFormat": "error %" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" },
        "thresholds": { "steps": [{"color":"green","value":0},{"color":"yellow","value":1},{"color":"red","value":5}] } } }
    },
    {
      "id": 3, "type": "stat", "title": "P95 Latency",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(ecomshop_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "thresholds" },
        "thresholds": { "steps": [{"color":"green","value":0},{"color":"yellow","value":0.5},{"color":"red","value":1}] } } }
    },
    {
      "id": 4, "type": "stat", "title": "In-Flight Requests",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "ecomshop_http_requests_in_flight", "legendFormat": "in-flight" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" },
        "thresholds": { "steps": [{"color":"green","value":0},{"color":"yellow","value":20},{"color":"red","value":50}] } } }
    },
    {
      "id": 5, "type": "stat", "title": "Memory Usage",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "ecomshop_process_resident_memory_bytes", "legendFormat": "RSS" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "thresholds" },
        "thresholds": { "steps": [{"color":"green","value":0},{"color":"yellow","value":256000000},{"color":"red","value":512000000}] } } }
    },
    {
      "id": 6, "type": "stat", "title": "CPU Usage",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "rate(ecomshop_process_cpu_seconds_total[1m]) * 100", "legendFormat": "CPU %" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" },
        "thresholds": { "steps": [{"color":"green","value":0},{"color":"yellow","value":70},{"color":"red","value":90}] } } }
    },
    {
      "id": 10, "type": "timeseries", "title": "HTTP Request Rate by Route",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum(rate(ecomshop_http_requests_total[1m])) by (route, method)", "legendFormat": "{{method}} {{route}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 11, "type": "timeseries", "title": "Request Latency Percentiles",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(ecomshop_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(ecomshop_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(ecomshop_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 20, "type": "timeseries", "title": "HTTP Status Codes",
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 7 },
      "targets": [{ "expr": "sum(rate(ecomshop_http_requests_total[1m])) by (status_code)", "legendFormat": "{{status_code}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 21, "type": "timeseries", "title": "Business Events",
      "gridPos": { "x": 8, "y": 12, "w": 8, "h": 7 },
      "targets": [
        { "expr": "rate(ecomshop_user_registrations_total[5m])", "legendFormat": "Registrations" },
        { "expr": "rate(ecomshop_login_attempts_total{result='success'}[5m])", "legendFormat": "Logins OK" },
        { "expr": "rate(ecomshop_login_attempts_total{result='failure'}[5m])", "legendFormat": "Logins Failed" },
        { "expr": "rate(ecomshop_cart_checkouts_total{result='success'}[5m])", "legendFormat": "Checkouts" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 22, "type": "timeseries", "title": "Cache Hit Rate",
      "gridPos": { "x": 16, "y": 12, "w": 8, "h": 7 },
      "targets": [
        { "expr": "rate(ecomshop_cache_hits_total[5m])", "legendFormat": "hits" },
        { "expr": "rate(ecomshop_cache_misses_total[5m])", "legendFormat": "misses" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 30, "type": "timeseries", "title": "Node.js Event Loop Lag",
      "gridPos": { "x": 0, "y": 19, "w": 8, "h": 7 },
      "targets": [{ "expr": "ecomshop_nodejs_eventloop_lag_seconds", "legendFormat": "event loop lag" }],
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "thresholds" },
        "thresholds": { "steps": [{"color":"green","value":0},{"color":"yellow","value":0.1},{"color":"red","value":0.5}] } } }
    },
    {
      "id": 31, "type": "timeseries", "title": "Node.js Active Handles & Requests",
      "gridPos": { "x": 8, "y": 19, "w": 8, "h": 7 },
      "targets": [
        { "expr": "ecomshop_nodejs_active_handles_total", "legendFormat": "handles" },
        { "expr": "ecomshop_nodejs_active_requests_total", "legendFormat": "requests" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 32, "type": "timeseries", "title": "Node.js Heap Usage",
      "gridPos": { "x": 16, "y": 19, "w": 8, "h": 7 },
      "targets": [
        { "expr": "ecomshop_nodejs_heap_size_used_bytes", "legendFormat": "heap used" },
        { "expr": "ecomshop_nodejs_heap_size_total_bytes", "legendFormat": "heap total" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    }
  ]
}
